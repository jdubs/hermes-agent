# Local image overlay — private fleet only, never pushed to upstream.
#
# Adds the gh/glab CLI layer, cluster/database utilities (kubectl, argocd,
# postgresql-client), and honcho-ai on top of the upstream image (built from
# the unmodified Dockerfile as :base). Kept as a separate file so the upstream
# Dockerfile carries ZERO local divergence: no git stash/pop, no rebase
# conflicts on the Dockerfile, clean provenance.
#
# Build with scripts/build-harbor.sh (local) or the GitLab CI kaniko jobs.
# The FROM tag must exist (local image or harbor) before this builds.
FROM harbor.home.xomar.com/hermes-agent/hermes-agent:base

ARG HERMES_GIT_SHA=0000000000000000000000000000000000000000
RUN echo "$HERMES_GIT_SHA" > /opt/hermes/.hermes_build_sha

# ---------- Fleet CLIs and Tools ----------
# Baked in so kanban workers and gateway pods have tools available without
# dynamic startup-time extraction or lazy installs (which fail because the image
# seals /opt/hermes). Same curl+sha256 pattern as upstream s6-overlay layer:
# checksums pinned per arch, tarball/deb verified before install.
#
# gh: official .deb from cli/cli GitHub releases.
# glab: official tarball from gitlab-org/cli GitLab releases.
# kubectl: official binary from Kubernetes releases.
# argocd: official binary from ArgoCD GitHub releases.
# postgresql-client: Debian package (psql, pg_dump, pg_restore).
ARG TARGETARCH
ARG GH_VERSION=2.100.0
ARG GH_AMD64_SHA256=698c8d88cc19cc92bfe96bad58d10b2a5b274c52433d6dc57799c81f6139d5fc
ARG GH_ARM64_SHA256=33ccd2ad7ce639c927e1cb209e36555b0e1fbb89f7a38239c0568040ec758612
ARG GLAB_VERSION=1.117.0
ARG GLAB_AMD64_SHA256=1edfd0fba284e93396a9fd8899b9fff10f34f90b733943b1a70e21431a1991ab
ARG GLAB_ARM64_SHA256=ce533c314b69014664020567d006b5c86435f0fa16561aba18929bea26506828
ARG KUBECTL_VERSION=v1.36.4
ARG KUBECTL_AMD64_SHA256=8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a
ARG KUBECTL_ARM64_SHA256=0ecf44450ee6063bf19dd166a103ee6df4a9034455c2abce626e6eea657d73fb
ARG ARGOCD_VERSION=v3.5.3
ARG ARGOCD_AMD64_SHA256=b860f73f57cbddd993cd446f5236d797c1b1ac8554857b2683d2669f17e765b4
ARG ARGOCD_ARM64_SHA256=bb37e5d62df897ea1610f7c647fdc78657a0e3a928dc21893faf7bf66a4646cb

RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
        amd64) \
            gh_sha="${GH_AMD64_SHA256}"; \
            glab_sha="${GLAB_AMD64_SHA256}"; \
            kubectl_sha="${KUBECTL_AMD64_SHA256}"; \
            argocd_sha="${ARGOCD_AMD64_SHA256}" ;; \
        arm64) \
            gh_sha="${GH_ARM64_SHA256}"; \
            glab_sha="${GLAB_ARM64_SHA256}"; \
            kubectl_sha="${KUBECTL_ARM64_SHA256}"; \
            argocd_sha="${ARGOCD_ARM64_SHA256}" ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH} for tools" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 -o /tmp/gh.deb \
        "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${TARGETARCH:-amd64}.deb"; \
    printf '%s  %s\n' "${gh_sha}" /tmp/gh.deb | sha256sum -c -; \
    apt-get -o Acquire::Retries=3 update -qq && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends /tmp/gh.deb postgresql-client libopus0 && \
    rm -rf /var/lib/apt/lists/* /tmp/gh.deb; \
    npm install -g --prefix /usr/local --allow-scripts=opencode-ai opencode-ai@latest; \
    opencode --version; \
    rm -rf /var/lib/apt/lists/* /tmp/gh.deb; \
    curl -fsSL --retry 3 -o /tmp/glab.tar.gz \
        "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_${TARGETARCH:-amd64}.tar.gz"; \
    printf '%s  %s\n' "${glab_sha}" /tmp/glab.tar.gz | sha256sum -c -; \
    tar -xzf /tmp/glab.tar.gz -C /tmp && \
    install -m 0755 /tmp/bin/glab /usr/local/bin/glab; \
    rm -rf /tmp/glab.tar.gz /tmp/bin /tmp/CHANGELOG.md /tmp/LICENSE /tmp/README.md; \
    curl -fsSL --retry 3 -o /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH:-amd64}/kubectl"; \
    printf '%s  %s\n' "${kubectl_sha}" /usr/local/bin/kubectl | sha256sum -c -; \
    chmod 0755 /usr/local/bin/kubectl; \
    curl -fsSL --retry 3 -o /usr/local/bin/argocd \
        "https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}/argocd-linux-${TARGETARCH:-amd64}"; \
    printf '%s  %s\n' "${argocd_sha}" /usr/local/bin/argocd | sha256sum -c -; \
    chmod 0755 /usr/local/bin/argocd; \
    gh --version && glab --version && kubectl version --client && argocd version --client --short && psql --version

# ---------- Memory plugin (honcho) ----------
COPY plugins/memory/honcho /opt/hermes/plugins/memory/honcho
COPY agent /opt/hermes/agent

# ---------- Python dependencies (honcho-ai) ----------
RUN set -eu; \
    uv_bin="$(python3 -c 'from pm._uv import _toolchain; print(_toolchain()[0])')"; \
    ln -s "$uv_bin" /usr/local/bin/uv; \
    uv pip install --python /opt/hermes/.venv/bin/python3 honcho-ai pytest pyyaml pytest-cov && \
    chmod -R a+rX /opt/hermes/.venv /opt/hermes/plugins/memory/honcho && \
    /opt/hermes/.venv/bin/python3 -c "import honcho, discord.opus; discord.opus._load_default(); assert discord.opus.is_loaded(); from plugins.memory.honcho.client import HonchoClientConfig; print('honcho-ai, honcho plugin, and discord.opus loaded successfully')"
